[Unit]
Description=orca-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=orca-relay
Group=orca-relay
WorkingDirectory=/opt/orca-relay
EnvironmentFile=/etc/orca-relay/orca-relay.env
ExecStart=/opt/orca-relay/orca-relay
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orca-relay

[Install]
WantedBy=multi-user.target
